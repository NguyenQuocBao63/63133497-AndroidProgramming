<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp">

    <ImageView
        android:id="@+id/imageView1"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/logontu" />

    <Button
        android:id="@+id/btnFunction2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chức năng 2" />

    <Button
        android:id="@+id/btnFunction3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chức năng 3" />

    <Button
        android:id="@+id/btnFunction4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chức năng 4" />

    <Button
        android:id="@+id/btnAboutMe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="About Me" />

    <Button
        android:id="@+id/btnExtra"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chức năng làm thêm" />

</LinearLayout>
